rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Swipes & Likes Tracking
    match /likes/{userId}/userLikes/{targetUserId} {
      allow read, write: if request.auth != null;
    }

    // 3. Incoming Like Requests & Matching Algorithm
    match /requests/{userId}/incomingLikes/{targetUserId} {
      allow read, write: if request.auth != null;
    }

    // 4. Matches & Real-Time Chat Engine
    match /matches/{matchId} {
      allow read, write: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 5. Agora Audio Calling & Signaling
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
  }
}
